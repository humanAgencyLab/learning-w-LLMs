# Application Configuration
NODE_ENV=development
PORT=5001
API_BASE_URL=http://localhost:5001

# Database
MONGODB_URI=mongodb://localhost:27017/learning-w-llms

# LLM Provider
GROQ_API_KEY=your_groq_api_key_here

# Rate Limiting (requests per minute)
RL_ASSESSMENT=5
RL_CHAT=12
RL_QUIZ_START=6
RL_QUIZ_SUBMIT=8
RL_GENERAL=30

# Context Control & Summarization
SUMMARIZE_EVERY_N_TURNS=40
SUMMARIZE_CHUNK_SIZE=20
SUMMARY_MAX_TOKENS=200

# Token Ceilings
TEACHER_MAX_TOKENS=1100
ASSESSMENT_MAX_TOKENS=500

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Multi-Agent Architecture (set to 'true' to enable agent orchestration; default: legacy)
USE_MULTI_AGENT=false
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODEL_CHEAP=llama-3.1-8b-instant

# Logging
LOG_LEVEL=info

# Build Information (set by CI/CD)
BUILD_SHA=unknown
VERSION=1.0.0

# Security
JWT_SECRET=your_jwt_secret_here
SESSION_SECRET=your_session_secret_here

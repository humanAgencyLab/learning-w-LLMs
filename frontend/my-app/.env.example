# Frontend Environment Variables
# Copy this file to .env and update the values as needed

# API Configuration
# Leave empty to use CRA proxy (recommended for local development)
# Set to your backend URL for production or custom development
REACT_APP_API_BASE_URL=

# Development Notes:
# - Empty REACT_APP_API_BASE_URL uses CRA proxy to http://localhost:5001
# - For production, set to your actual backend URL
# - For custom development, set to your backend URL (e.g., http://localhost:5001)
